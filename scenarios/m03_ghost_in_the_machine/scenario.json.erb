    "server_room": {
      "type": "room_servers",
      "connections": {
        "south": "main_hallway"
      },
      "locked": true,
      "lockType": "rfid",
      "requires": "victoria_keycard_clone",
      "objects": [
        {
          "type": "safe",
          "id": "server_filing_cabinet",
