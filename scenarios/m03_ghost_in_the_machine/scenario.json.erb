              "completeTask": "meet_victoria",
              "setGlobal": { "victoria_fate": "ko" }
            },
            {
              "eventPattern": "global_variable_changed:victoria_ko",
              "condition": "value === true",
              "onceOnly": true,
              "completeTask": "clone_rfid_card"
            },
            {
              "eventPattern": "global_variable_changed:victoria_ko",
              "condition": "value === true && globalVars.night_confrontation_ready === true",
              "onceOnly": true,
              "setGlobal": { "victoria_choice_made": true }
            },
            {
              "eventPattern": "objective_task_completed:submit_distcc_flag",
              "condition": "globalVars.victoria_ko === true",
              "onceOnly": true,
              "setGlobal": { "victoria_choice_made": true }
            },
            {
              "eventPattern": "global_variable_changed:whiteboard_seen",
              "condition": "value === true",
              "onceOnly": true,
              "completeTask": "decode_whiteboard"
            },
            {
              "eventPattern": "global_variable_changed:roster_seen",
              "condition": "value === true",
              "onceOnly": true,
              "completeTask": "decode_client_roster"
            },
            {
              "eventPattern": "global_variable_changed:usb_seen",
              "condition": "value === true",
              "onceOnly": true,
              "completeTask": "lore_fragment_3"
            }
          ]
        },
        {
          "id": "closing_debrief",
          "displayName": "Agent 0x99",
          "npcType": "phone",
          "storyPath": "scenarios/m03_ghost_in_the_machine/ink/m03_closing_debrief.json",
          "avatar": "assets/npc/avatars/npc_helper.png",
          "phoneId": "player_phone",
          "currentKnot": "start",
          "eventMappings": [
            {
              "eventPattern": "global_variable_changed:victoria_choice_made",
              "targetKnot": "start",
              "conversationMode": "phone-chat",
              "condition": "value === true",
              "onceOnly": true
            }
          ]
        }
      ]
    },

    "main_hallway": {
      "type": "hall_1x2gu",
      "connections": {
        "south": "reception_lobby",
        "west": "conference_room_01",
        "north": "server_room",
        "east": "executive_wing_hallway"
      },
      "objects": [],
      "npcs": [
        {
          "id": "night_guard",
          "displayName": "Security Guard",
          "npcType": "person",
          "position": {"x": 10, "y": 2},
          "storyPath": "scenarios/m03_ghost_in_the_machine/ink/m03_npc_guard.json",
          "currentKnot": "start",
          "spriteSheet": "hacker-red",
          "spriteTalk": "assets/characters/hacker-red-talk.png",
          "spriteConfig": {
            "idleFrameStart": 20,
            "idleFrameEnd": 23
          },
          "globalVarOnKO": "guard_knocked_out",
          "behavior": {
            "patrol": {
              "enabled": true,
              "waypoints": [
                { "x": 3, "y": 2, "dwellTime": 2000 },
                { "x": 10, "y": 2 },
                { "x": 17, "y": 2, "dwellTime": 2000 },
                { "x": 10, "y": 2 }
              ],
              "speed": 40,
              "loop": true
            }
          },
          "los": {
            "enabled": true,
            "range": 150,
            "angle": 120,
            "visualize": true
          },
          "eventMappings": [
            {
              "eventPattern": "lockpick_used_in_view",
              "targetKnot": "on_lockpick_detected",
              "conversationMode": "person-chat",
              "background": "assets/backgrounds/background1.png",
              "onceOnly": false,
              "cooldown": 30000
            },
            {
              "eventPattern": "room_entered:server_room",
              "targetKnot": "on_restricted_area",
              "conversationMode": "person-chat",
              "background": "assets/backgrounds/background1.png",
              "onceOnly": true
            }
          ]
        }
      ]
    },

    "conference_room_01": {
      "type": "room_office",
      "locked": true,
      "lockType": "rfid",
