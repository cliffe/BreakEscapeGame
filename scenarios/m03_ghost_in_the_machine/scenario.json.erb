            {
              "type": "text_file",
              "name": "Q3 2024 Exploit Catalog",
              "takeable": true,
              "readable": true,
              "text": "<%= json_escape(lore_fragment_2) %>"
            }
          ]
        },
        {
          "type": "notes",
          "name": "Server Room Whiteboard",
          "takeable": false,
          "readable": true,
          "text": "<%= whiteboard_message_encoded %>",
