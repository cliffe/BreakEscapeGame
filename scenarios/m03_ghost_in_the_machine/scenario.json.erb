          "onRead": { "setVariable": { "whiteboard_seen": true } }
        },
        {
          "type": "vm-launcher",
          "id": "vm_launcher_zero_day",
          "name": "VM Access Terminal",
          "takeable": false,
          "observations": "Terminal for accessing Zero Day training network VMs",
          "hacktivityMode": <%= vm_context && vm_context['hacktivity_mode'] ? 'true' : 'false' %>,
          "vm": <%= vm_object('ghost_in_machine_vm_network', {"id":1,"title":"Zero Day Training Network","ip":"192.168.100.0/24","enable_console":true}) %>
        },
        {
          "type": "workstation",
          "id": "cyberchef_workstation",
          "name": "CyberChef Workstation",
          "takeable": true,
          "puzzle_graph_role": "tool",
          "puzzle_graph_note": "Decoding tool — take it, then paste the whiteboard, client roster, and USB drive text in to reveal the intel",
          "observations": "A laptop preloaded with CyberChef. Take it, then paste any encoded text you find — ROT13, Base64, Hex, and layered combinations all decode here."
        },
        {
          "type": "flag-station",
          "id": "flag_station_dropsite",
          "name": "Drop-Site Terminal",
          "takeable": false,
          "observations": "Terminal for submitting VM flags from Zero Day training network",
