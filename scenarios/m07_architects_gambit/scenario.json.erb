# ============================================================================

require 'base64'

def base64_encode(text)
  Base64.strict_encode64(text)
end

def rot13(text)
  text.tr('A-Za-z', 'N-ZA-Mn-za-m')
end

# --- Secrets -----------------------------------------------------------------
# Written on the maintenance log in the generator room, and spoken by Elena.
vault_pin = "4703"

# SCADA control room door. Elena gives it; the netcat C2 traffic (VM flag 2)
# carries it as the redundant source.
scada_password = "CascadeWindow19"
