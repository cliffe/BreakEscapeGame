        {
          "_comment": "Agent HaX -- handler, phone NPC on player_phone, reachable from every room. Runs the delegation, the redirect window, the five field guides and the per-stage VM hints. WP6 adds itemsHeld and the hub gating; WP9 adds the voice block.",
          "id": "agent_0x99",
          "displayName": "Agent HaX",
          "npcType": "phone",
          "phoneId": "player_phone",
          "avatar": "assets/characters/female_spy_headshot.png",
          "storyPath": "scenarios/m07_architects_gambit/ink/m07_phone_agent_0x99.json",
          "voice": {
            "name": "Aoede",
            "style": "Intelligence handler on a secure line, running four crises at once with one agent in range. Consistent British Received Pronunciation accent throughout -- do not shift to any other accent. Quick, dry, clipped. Fond of the agent and audibly under strain, which she handles by getting drier rather than louder.",
            "language": "en-GB"
          },
          "currentKnot": "start",
<%# WP2 STATE BRIDGES on the handler. Two jobs only:
      (a) turn engine-observed progress into the globals CONTRACT.md S6 says the
          hub and the ink read, so nothing depends on a conversation being had;
      (b) acknowledge a knockout out loud and point at the redundant source, so
          a KO never leaves the player staring at a lock with no route.
    A flag reward can carry exactly one set_global, so the secondary narrative
    globals are derived here from flagN_submitted.
    WP6 owns the hub's own dialogue eventMappings and appends to this array. %>
          "eventMappings": [
            {
              "_comment": "The delegation is what starts the countdown timers. Latched here as well as in ink so the clock cannot fail to start.",
              "eventPattern": "objective_task_completed:assign_tactical_team",
              "onceOnly": true,
              "setGlobal": { "team_assigned": true }
            },
            {
              "_comment": "Flag 1 -- the coordination traffic. This is the second, KO-proof source of the projection revision; Elena is the first.",
              "eventPattern": "global_variable_changed:flag1_submitted",
              "condition": "value === true",
              "onceOnly": true,
              "setGlobal": { "found_coordination_traffic": true, "projection_revised": true },
              "sendTimedMessage": { "delay": 1500, "message": "Four operations, one schedule, one authority -- and the TechForge manifest has EHR- and CAD- vendors on it with a nine-day dormancy, not the ninety you were briefed. The projection you were given was understated. If you want to move the team, say so now." }
            },
            {
              "_comment": "Flag 2 -- the C2 channel carries the SCADA door password. Redundant with Elena.",
              "eventPattern": "global_variable_changed:flag2_submitted",
              "condition": "value === true",
              "onceOnly": true,
              "setGlobal": { "scada_password_found": true },
              "sendTimedMessage": { "delay": 1500, "message": "Their own command channel is passing the control room password in clear. That door is open to you now whether or not anyone in there wants to help." }
            },
            {
              "_comment": "Flag 3 closes the redirect window from the progress side. CONTRACT.md S5: the boolean is written by the 40-minute timer OR by flag3_submitted, so the door shuts for a fast player and a slow one alike.",
              "eventPattern": "global_variable_changed:flag3_submitted",
              "condition": "value === true",
              "onceOnly": true,
              "setGlobal": { "redirect_window_closed": true }
            },
            {
              "eventPattern": "global_variable_changed:flag4_submitted",
              "condition": "value === true",
              "onceOnly": true,
              "sendTimedMessage": { "delay": 1500, "message": "Attack host is down and locked out. The cascade control system in the control room will take an abort now. Go and give it one." }
            },
            {
              "_comment": "recover_vault_pin is a custom task with two sources -- the maintenance log's onRead and Elena's dialogue. Both write vault_pin_found, so the task completes from either.",
              "eventPattern": "global_variable_changed:vault_pin_found",
              "condition": "value === true",
              "onceOnly": true,
              "completeTask": "recover_vault_pin"
            },
            {
              "_comment": "KO acknowledgement -- Morrison. His badge is one of two RFID sources.",
              "eventPattern": "global_variable_changed:morrison_ko",
              "condition": "value === true",
              "onceOnly": true,
              "sendTimedMessage": { "delay": 2000, "message": "Morrison is down. Take the badge off him -- and if you would rather not go through his pockets, the contractor badge printer behind his desk is still logged in as the day shift." }
            },
            {
              "_comment": "KO acknowledgement -- Elena. She held the vault PIN and the control room password; both have a second source.",
              "eventPattern": "global_variable_changed:elena_ko",
              "condition": "value === true",
              "onceOnly": true,
              "sendTimedMessage": { "delay": 2000, "message": "She is not talking now. Whatever she knew, you get the hard way: the vault keypad code is on the maintenance log in the generator hall, and the control room password is going over their own command channel. Neither of those needs her." }
            },
            {
              "eventPattern": "global_variable_changed:park_ko",
              "condition": "value === true",
              "onceOnly": true,
              "sendTimedMessage": { "delay": 2000, "message": "Park is out of it. The vault is yours to search -- and whatever he was down there to cut, he has not finished cutting." }
            },
            {
              "eventPattern": "global_variable_changed:mercer_ko",
              "condition": "value === true",
              "onceOnly": true,
              "sendTimedMessage": { "delay": 2000, "message": "Mercer is on the floor. Nothing about the sequence changes -- it is scheduled, it is local, and it never needed him awake. Finish the host." }
            },
<%# WP6 -- field-guide exposure gates. Each sets a *_guide_offered global the
      first time the player hits the obstacle the guide explains; the hub then
      surfaces the delivery choice. No guide is ever offered before its obstacle. %>
            {
              "_comment": "RFID guide -- offered when the player first tries the badge door into the server room.",
              "eventPattern": "door_unlock_attempt",
              "condition": "data.connectedRoom === 'server_room'",
              "onceOnly": true,
              "setGlobal": { "rfid_guide_offered": true },
              "sendTimedMessage": { "delay": 1500, "message": "That reader wants a server-zone badge. Morrison's carrying one, and the contractor printer at the checkpoint will run you a fresh one. Either way you clone it, not borrow it -- want the RFID field guide?" }
            },
            {
              "_comment": "Lockpicking guide -- offered when the player first tries the keyed door into the generator room.",
              "eventPattern": "door_unlock_attempt",
              "condition": "data.connectedRoom === 'generator_room'",
              "onceOnly": true,
              "setGlobal": { "lockpicking_guide_offered": true },
              "sendTimedMessage": { "delay": 1500, "message": "Keyed lock. The maintenance key's on the ops floor, but you're carrying picks and that door will open to them. Say the word if you want the lockpicking field guide." }
            },
            {
              "_comment": "Recon guide -- offered on entering the server room, where the network work begins.",
              "eventPattern": "room_entered:server_room",
              "onceOnly": true,
              "setGlobal": { "recon_guide_offered": true },
              "sendTimedMessage": { "delay": 2500, "message": "You're on their control network now. Before you exploit anything, map it -- want the recon and network mapping field guide?" }
            },
            {
              "_comment": "Scanning/exploitation guide -- offered when the player first interacts with the Kali vm-launcher.",
              "eventPattern": "object_interacted",
              "condition": "data.objectType === 'vm-launcher'",
              "onceOnly": true,
              "setGlobal": { "scanning_guide_offered": true },
              "sendTimedMessage": { "delay": 1500, "message": "That's your attack box. Fingerprint before you fire -- want the scanning and exploitation field guide?" }
            },
            {
              "_comment": "Privesc guide -- offered once flag 2 is in, i.e. the player has a foothold and next needs root.",
              "eventPattern": "global_variable_changed:flag2_submitted",
              "condition": "value === true",
              "onceOnly": true,
              "setGlobal": { "privesc_guide_offered": true },
              "sendTimedMessage": { "delay": 4000, "message": "A user shell won't stop their processes -- you'll need root next. Want the privilege escalation field guide?" }
            }
          ],
          "itemsHeld": [
            {
              "type": "lab-workstation",
              "key_id": "m07_rfid_field_guide",
              "name": "SAFETYNET Field Guide: RFID Cloning",
