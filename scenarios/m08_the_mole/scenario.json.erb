          "type": "flag-station",
          "id": "flag_station_evidence_relay",
          "name": "Evidence Relay Terminal",
          "takeable": false,
          "observations": "Secure relay for submitting recovered evidence back to Director Netherton. Everything you pull off the repository server goes through here.",
          "acceptsVms": ["safetynet_gitlist_server"],
          "flags": <%= flags_for_vm('safetynet_gitlist_server', ['flag{gitlist_argument_injection}', 'flag{stashed_credentials_recovered}', 'flag{home_directory_access}', 'flag{root_via_sudo_apt}']) %>,
<%# flagRewards is INDEX-PARALLEL to flags -- one reward per flag, in order.
    set_global is forwarded to the client untouched. emit_event is NOT usable
    here. The narrative globals (found_gitlist_vuln, found_leaked_creds,
    found_architect_comms, found_access_logs, all_flags_submitted,
    mole_identified) hang off these four booleans as eventMappings on
    agent_0x99, because one flag can carry exactly one reward. %>
          "flagRewards": [
            { "type": "set_global", "key": "flag1_submitted", "value": true, "description": "GitList argument injection -- RCE on SAFETYNET's own repo browser, no login" },
            { "type": "set_global", "key": "flag2_submitted", "value": true, "description": "Stashed credentials recovered from repository history" },
            { "type": "set_global", "key": "flag3_submitted", "value": true, "description": "Logged in properly -- home directory holds the ENTROPY correspondence" },
            { "type": "set_global", "key": "flag4_submitted", "value": true, "description": "Root via sudo apt-get -- access logs place the mole" }
          ]
        },
        {
          "type": "text_file",
          "id": "server_access_logs",
          "name": "Server Access Log (excerpt)",
          "takeable": true,
          "readable": true,
          "observations": "A printed excerpt of the auth log, left by the rack. Once you have root on the box, the full log tells the same story in more detail.",
          "observationDisplay": "gameDisplay",
          "text": "AUTH LOG -- mission_planning share\n\n... routine ...\nUSER nightshade_ops  T-48h (before M7)  OPEN m07_operations.enc  DURATION 00:47:00\n... routine ...\n\n47 minutes on a file you read in five. The timing lines up exactly with the window ENTROPY started coordinating. Whoever nightshade_ops is, they weren't reading the plan. They were copying it.",
          "onPickup": { "setVariable": { "found_access_logs_hint": true } }
        }
      ]
    },

