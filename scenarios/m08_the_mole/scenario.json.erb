    actually finishing -- the m01/m02/m07 pattern. %>
  "music": {
    "events": [
      { "trigger": "game_loaded", "condition": "!globalVars.briefing_played", "playlist": "cutscene", "fade": false },
      { "trigger": "game_loaded", "condition": "globalVars.briefing_played === true", "playlist": "noir", "fade": false },
      { "trigger": "global_variable_changed:flag2_submitted", "condition": "value === true", "playlist": "tension" },
      { "trigger": "global_variable_changed:mole_identified", "condition": "value === true", "playlist": "threat" },
      { "trigger": "room_entered:interrogation_room", "playlist": "spy-action" },
      { "trigger": "conversation_ended:m08_closing_debrief", "playlist": "victory" }
    ]
  },

  "startItemsInInventory": [
    {
      "type": "phone",
      "name": "Your Phone",
      "takeable": true,
      "phoneId": "player_phone",
      "npcIds": ["agent_0x99"],
      "observations": "Your secure phone. Agent HaX is on one end of it. She has known all three of your suspects for years, and it shows."
    },
    {
      "type": "lockpick",
      "name": "Lock Pick Kit",
      "takeable": true,
      "observations": "SAFETYNET field pick kit. The fallback for the interrogation room if the safe key never turns up.",
      "puzzle_graph_role": "tool",
      "puzzle_graph_unlocks": ["interrogation_room"],
      "puzzle_graph_optional": true
    }
  ],

  "player": {
    "id": "player",
    "displayName": "Agent 0x00",
    "spriteSheet": "male_hacker_hood_down",
    "spriteTalk": "assets/characters/male_hacker_hood_down_talk.png",
    "spriteConfig": { "idleFrameRate": 6, "walkFrameRate": 10 }
  },

